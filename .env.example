PORT=5000

DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/coffee_404"

# Token secrets — BOTH are REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"
REFRESH_TOKEN_SECRET="CHANGE_THIS_TO_ANOTHER_STRONG_RANDOM_SECRET"

# Token expiry — spec requires 86400 seconds (24 hours) for both
JWT_EXPIRES_IN="86400s"
JWT_REFRESH_EXPIRES_IN="86400s"

NODE_ENV="development"

# AI Chat (DeepSeek)
DEEPSEEK_API_KEY="sk-..."
DEEPSEEK_MODEL="deepseek-chat"

# CORS (comma-separated origins, default: localhost:3000,5173,5174)
# CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# AI Rate Limiting (optional)
AI_RATE_LIMIT_WINDOW_MS=900000
AI_RATE_LIMIT_MAX_REQUESTS=30
