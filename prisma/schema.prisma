generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         Int                     @id @default(autoincrement())
  name                       String
  passwordHash               String
  position                   String
  role                       Role                    @default(MANAGER)
  status                     UserStatus              @default(ACTIVE)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  jobTitle                   String?
  workStartTime              String?
  workEndTime                String?
  attendance                 Attendance[]
  auditLogs                  AuditLog[]
  closedShifts               CashDrawerShift[]       @relation("ClosedShifts")
  openedShifts               CashDrawerShift[]       @relation("OpenedShifts")
  recordedDrawerTransactions CashDrawerTransaction[] @relation("RecordedDrawerTransactions")
  approvedDevices            EmployeeDevice[]        @relation("ApprovedByUser")
  devices                    EmployeeDevice[]        @relation("DeviceOwner")
  orderEvents                OrderEvent[]
  updatedSettings            Setting[]               @relation("UpdatedSettings")
  pageAccess                 UserPageAccess?

  @@map("users")
}

model RawMaterial {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique
  unit                   String
  supplier               String
  minStockAlert          Decimal
  expiryAlertDays        Int?
  addedAt                DateTime                @default(now())
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  productSizeIngredients ProductSizeIngredient[]
  productTypeIngredients ProductTypeIngredient[]
  purchaseItems          PurchaseItem[]
  batches                RawMaterialBatch[]
  returnItems            ReturnItem[]

  @@map("raw_materials")
}

model RawMaterialBatch {
  id            Int         @id @default(autoincrement())
  rawMaterialId Int
  quantity      Decimal
  pricePerUnit  Decimal
  expiryDate    DateTime?
  addedAt       DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@index([rawMaterialId])
  @@index([expiryDate])
  @@map("raw_material_batches")
}

model Product {
  id          Int            @id @default(autoincrement())
  name        String         @unique
  description String?
  image       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    String?
  isActive    Boolean        @default(true)
  orderItems  OrderItem[]
  addons      ProductAddon[]
  sizes       ProductSize[]
  types       ProductType[]
  saleItems   SaleItem[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model ProductType {
  id          Int                     @id @default(autoincrement())
  productId   Int
  name        String
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  ingredients ProductTypeIngredient[]
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_types")
}

model ProductTypeIngredient {
  id            Int         @id @default(autoincrement())
  productTypeId Int
  rawMaterialId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([productTypeId, rawMaterialId])
  @@index([productTypeId])
  @@index([rawMaterialId])
  @@map("product_type_ingredients")
}

model ProductSize {
  id          Int                     @id @default(autoincrement())
  productId   Int
  typeName    String
  name        String
  basePrice   Decimal
  finalPrice  Decimal
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  isActive    Boolean                 @default(true)
  orderItems  OrderItem[]
  ingredients ProductSizeIngredient[]
  product     Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]

  @@unique([productId, typeName, name])
  @@index([productId])
  @@map("product_sizes")
}

model ProductSizeIngredient {
  id            Int         @id @default(autoincrement())
  productSizeId Int
  rawMaterialId Int
  quantity      Decimal
  unit          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  productSize   ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([productSizeId, rawMaterialId])
  @@index([productSizeId])
  @@index([rawMaterialId])
  @@map("product_size_ingredients")
}

model ProductAddon {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
  @@map("product_addons")
}

model Customer {
  id            Int      @id @default(autoincrement())
  name          String
  phone         String   @unique
  whatsapp      String?
  email         String?
  image         String?
  city          String?
  address       String?
  loyaltyPoints Int      @default(0)
  loyaltyLevel  String   @default("REGULAR")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  feedback      String?
  orderType     String?
  social        Json?
  orders        Order[]
  sales         Sale[]

  @@index([name])
  @@map("customers")
}

model Supplier {
  id                    Int        @id @default(autoincrement())
  name                  String
  contactPerson         String
  phone                 String
  email                 String?
  country               String?
  city                  String
  address               String?
  taxRegistrationNumber String?
  supplierType          String
  supplierCategory      String
  paymentTerms          String?
  creditLimit           Decimal    @default(0)
  openingBalance        Decimal    @default(0)
  notes                 String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  purchases             Purchase[]
  returns               Return[]

  @@map("suppliers")
}

model Purchase {
  id          Int            @id @default(autoincrement())
  invoiceNo   String         @unique
  supplierId  Int
  invoiceDate DateTime
  discount    Decimal        @default(0)
  total       Decimal
  finalTotal  Decimal
  status      PurchaseStatus @default(DRAFT)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  items       PurchaseItem[]
  supplier    Supplier       @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([invoiceDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id            Int         @id @default(autoincrement())
  purchaseId    Int
  rawMaterialId Int
  quantity      Decimal
  unit          String
  pricePerUnit  Decimal
  totalPrice    Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  purchase      Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@map("purchase_items")
}

model Sale {
  id            Int           @id @default(autoincrement())
  customerId    Int?
  subtotal      Decimal
  discount      Decimal       @default(0)
  total         Decimal
  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  orders        Order[]
  items         SaleItem[]
  customer      Customer?     @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id            Int         @id @default(autoincrement())
  saleId        Int
  productId     Int
  productSizeId Int
  quantity      Decimal
  unitPrice     Decimal
  totalPrice    Decimal
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  product       Product     @relation(fields: [productId], references: [id])
  productSize   ProductSize @relation(fields: [productSizeId], references: [id])
  sale          Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@index([productSizeId])
  @@map("sale_items")
}

model Order {
  id              Int           @id @default(autoincrement())
  customerId      Int?
  delegateId      Int?
  orderType       OrderType     @default(tables)
  status          OrderStatus   @default(PENDING)
  phone           String?
  subtotal        Decimal
  discount        Decimal       @default(0)
  total           Decimal
  paymentMethod   PaymentMethod @default(CASH)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  channel         String?
  customerName    String?
  deliveryAddress Json?
  fulfillmentType String?
  orderNumber     String        @unique
  table           String?
  trackingToken   String?       @unique
  version         Int           @default(1)
  deliveredAt     DateTime?
  saleId          Int?
  events          OrderEvent[]
  items           OrderItem[]
  customer        Customer?     @relation(fields: [customerId], references: [id])
  delegate        Delegate?     @relation(fields: [delegateId], references: [id])
  sales           Sale?         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([delegateId])
  @@index([orderType])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([trackingToken])
  @@index([saleId])
  @@map("orders")
}

model OrderItem {
  id            Int             @id @default(autoincrement())
  orderId       Int
  productId     Int
  productSizeId Int
  quantity      Decimal
  unitPrice     Decimal
  totalPrice    Decimal
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  status        OrderItemStatus @default(PENDING)
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  productSize   ProductSize     @relation(fields: [productSizeId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productSizeId])
  @@index([status])
  @@map("order_items")
}

model Return {
  id            Int          @id @default(autoincrement())
  returnNo      String       @unique
  supplierId    Int
  returnDate    DateTime     @default(now())
  generalReason String?
  notes         String?
  totalQuantity Decimal      @default(0)
  totalValue    Decimal      @default(0)
  status        ReturnStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  items         ReturnItem[]
  supplier      Supplier     @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
  @@index([returnDate])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id            Int         @id @default(autoincrement())
  returnId      Int
  rawMaterialId Int
  quantity      Decimal
  unit          String
  pricePerUnit  Decimal
  totalPrice    Decimal
  reason        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])
  return        Return      @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([rawMaterialId])
  @@map("return_items")
}

model Delegate {
  id        Int            @id @default(autoincrement())
  name      String
  whatsapp  String
  phone     String
  image     String?
  status    DelegateStatus @default(AVAILABLE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  isActive  Boolean        @default(true)
  orders    Order[]

  @@index([name])
  @@index([status])
  @@index([isActive])
  @@map("delegates")
}

model CashDrawerShift {
  id             Int                     @id @default(autoincrement())
  openedByUserId Int
  openedAt       DateTime                @default(now())
  openingBalance Decimal
  closedByUserId Int?
  closedAt       DateTime?
  closingBalance Decimal?
  actualBalance  Decimal?
  difference     Decimal?
  notes          String?
  status         ShiftStatus             @default(OPEN)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  closedByUser   User?                   @relation("ClosedShifts", fields: [closedByUserId], references: [id])
  openedByUser   User                    @relation("OpenedShifts", fields: [openedByUserId], references: [id])
  transactions   CashDrawerTransaction[]

  @@index([openedByUserId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_drawer_shifts")
}

model CashDrawerTransaction {
  id               Int                   @id @default(autoincrement())
  shiftId          Int
  type             DrawerTransactionType
  amount           Decimal
  description      String?
  recordedByUserId Int
  createdAt        DateTime              @default(now())
  recordedByUser   User                  @relation("RecordedDrawerTransactions", fields: [recordedByUserId], references: [id])
  shift            CashDrawerShift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@index([type])
  @@map("cash_drawer_transactions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int?
  page        String
  action      String
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([page])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Review {
  id            Int      @id @default(autoincrement())
  customerName  String
  customerPhone String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

model Setting {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  value           String?
  description     String?
  updatedByUserId Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedByUser   User?    @relation("UpdatedSettings", fields: [updatedByUserId], references: [id])

  @@map("settings")
}

model ProductCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Attendance {
  id                Int       @id @default(autoincrement())
  userId            Int
  checkInAt         DateTime
  checkOutAt        DateTime?
  status            String    @default("ON_TIME")
  lateMinutes       Int       @default(0)
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deviceFingerprint String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([checkInAt])
  @@map("attendance")
}

model EmployeeDevice {
  id                Int       @id @default(autoincrement())
  userId            Int
  name              String
  deviceFingerprint String    @unique
  deviceInfo        Json?
  status            String    @default("PENDING")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  approvedByUserId  Int?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  approvedBy        User?     @relation("ApprovedByUser", fields: [approvedByUserId], references: [id])
  user              User      @relation("DeviceOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("employee_devices")
}

model OrderEvent {
  id        Int      @id @default(autoincrement())
  orderId   Int
  type      String
  status    String?
  notes     String?
  userId    Int?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("order_events")
}

model UserPageAccess {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  pages     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_page_access")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  DELEGATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum OrderType {
  tables
  online
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

enum ReturnStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum DelegateStatus {
  AVAILABLE
  UNAVAILABLE
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DrawerTransactionType {
  SALES
  COLLECTION
  EXPENSE
  SALARY
  MAINTENANCE
  PURCHASE
  INCENTIVE
}
