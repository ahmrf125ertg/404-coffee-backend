// This is your Prisma schema file
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  passwordHash String
  position     String
  role         Role       @default(MANAGER)
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  openedShifts               CashDrawerShift[]       @relation("OpenedShifts")
  closedShifts               CashDrawerShift[]       @relation("ClosedShifts")
  recordedDrawerTransactions CashDrawerTransaction[] @relation("RecordedDrawerTransactions")

  auditLogs       AuditLog[]
  updatedSettings Setting[]  @relation("UpdatedSettings")

  attendance  Attendance[]
  devices     EmployeeDevice[]
  orderEvents OrderEvent[]

  @@map("users")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  DELEGATE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

model RawMaterial {
  id              Int     @id @default(autoincrement())
  name            String  @unique
  unit            String
  supplier        String
  minStockAlert   Decimal
  expiryAlertDays Int?

  addedAt   DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches RawMaterialBatch[]

  productTypeIngredients ProductTypeIngredient[]
  productSizeIngredients ProductSizeIngredient[]

  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]

  @@map("raw_materials")
}

model RawMaterialBatch {
  id            Int       @id @default(autoincrement())
  rawMaterialId Int
  quantity      Decimal
  pricePerUnit  Decimal
  expiryDate    DateTime?
  addedAt       DateTime  @default(now())

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rawMaterialId])
  @@index([expiryDate])
  @@map("raw_material_batches")
}

model Product {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  image       String?
  category    String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  types      ProductType[]
  sizes      ProductSize[]
  addons     ProductAddon[]
  saleItems  SaleItem[]
  orderItems OrderItem[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

model ProductType {
  id        Int    @id @default(autoincrement())
  productId Int
  name      String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredients ProductTypeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_types")
}

model ProductTypeIngredient {
  id            Int @id @default(autoincrement())
  productTypeId Int
  rawMaterialId Int

  productType ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productTypeId, rawMaterialId])
  @@index([productTypeId])
  @@index([rawMaterialId])
  @@map("product_type_ingredients")
}

model ProductSize {
  id        Int     @id @default(autoincrement())
  productId Int
  typeName  String
  name      String
  isActive  Boolean @default(true)

  basePrice  Decimal
  finalPrice Decimal

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredients ProductSizeIngredient[]
  saleItems   SaleItem[]
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, typeName, name])
  @@index([productId])
  @@map("product_sizes")
}

model ProductSizeIngredient {
  id            Int @id @default(autoincrement())
  productSizeId Int
  rawMaterialId Int

  quantity Decimal
  unit     String

  productSize ProductSize @relation(fields: [productSizeId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productSizeId, rawMaterialId])
  @@index([productSizeId])
  @@index([rawMaterialId])
  @@map("product_size_ingredients")
}

model ProductAddon {
  id        Int     @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal
  notes     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@map("product_addons")
}

model Customer {
  id            Int     @id @default(autoincrement())
  name          String
  phone         String  @unique
  whatsapp      String?
  email         String?
  image         String?
  city          String?
  address       String?
  orderType     String?
  social        Json?
  feedback      String?
  loyaltyPoints Int     @default(0)
  loyaltyLevel  String  @default("REGULAR")
  notes         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales  Sale[]
  orders Order[]

  @@index([name])
  @@map("customers")
}

model Supplier {
  id                    Int     @id @default(autoincrement())
  name                  String
  contactPerson         String
  phone                 String
  email                 String?
  country               String?
  city                  String
  address               String?
  taxRegistrationNumber String?
  supplierType          String
  supplierCategory      String
  paymentTerms          String?
  creditLimit           Decimal @default(0)
  openingBalance        Decimal @default(0)
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  returns   Return[]

  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model Purchase {
  id         Int    @id @default(autoincrement())
  invoiceNo  String @unique
  supplierId Int

  invoiceDate DateTime
  discount    Decimal  @default(0)
  total       Decimal
  finalTotal  Decimal

  status PurchaseStatus @default(DRAFT)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items PurchaseItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([invoiceDate])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id Int @id @default(autoincrement())

  purchaseId    Int
  rawMaterialId Int

  quantity     Decimal
  unit         String
  pricePerUnit Decimal
  totalPrice   Decimal

  purchase    Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@map("purchase_items")
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

model Sale {
  id Int @id @default(autoincrement())

  customerId Int?

  subtotal Decimal
  discount Decimal @default(0)
  total    Decimal

  paymentMethod PaymentMethod @default(CASH)
  status        SaleStatus    @default(COMPLETED)

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([createdAt])
  @@index([status])
  @@map("sales")
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int
  productId     Int
  productSizeId Int
  quantity      Decimal
  unitPrice     Decimal
  totalPrice    Decimal

  sale        Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  productSize ProductSize @relation(fields: [productSizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([saleId])
  @@index([productId])
  @@index([productSizeId])
  @@map("sale_items")
}

// ============================================================
// Orders
// ============================================================

enum OrderType {
  tables
  online
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

model Order {
  id            Int     @id @default(autoincrement())
  orderNumber   String  @unique
  customerName  String?
  trackingToken String? @unique

  customerId Int?
  delegateId Int?

  orderType       OrderType   @default(tables)
  channel         String?
  fulfillmentType String?
  status          OrderStatus @default(PENDING)
  table           String?

  phone String?

  deliveryAddress Json?

  subtotal Decimal
  discount Decimal @default(0)
  total    Decimal

  paymentMethod PaymentMethod @default(CASH)

  notes String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  delegate Delegate? @relation(fields: [delegateId], references: [id], onDelete: SetNull)

  items  OrderItem[]
  events OrderEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([delegateId])
  @@index([orderType])
  @@index([status])
  @@index([paymentMethod])
  @@index([createdAt])
  @@index([orderNumber])
  @@index([trackingToken])
  @@map("orders")
}

model OrderItem {
  id Int @id @default(autoincrement())

  orderId       Int
  productId     Int
  productSizeId Int

  quantity   Decimal
  unitPrice  Decimal
  totalPrice Decimal
  status     OrderItemStatus @default(PENDING)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id])
  productSize ProductSize @relation(fields: [productSizeId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([productSizeId])
  @@index([status])
  @@map("order_items")
}

// ============================================================
// Returns
// ============================================================

enum ReturnStatus {
  DRAFT
  APPROVED
  CANCELLED
}

model Return {
  id         Int    @id @default(autoincrement())
  returnNo   String @unique
  supplierId Int

  returnDate DateTime @default(now())

  generalReason String?
  notes         String?

  totalQuantity Decimal @default(0)
  totalValue    Decimal @default(0)

  status ReturnStatus @default(DRAFT)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([returnDate])
  @@index([status])
  @@map("returns")
}

model ReturnItem {
  id Int @id @default(autoincrement())

  returnId      Int
  rawMaterialId Int

  quantity     Decimal
  unit         String
  pricePerUnit Decimal
  totalPrice   Decimal

  reason String?

  return      Return      @relation(fields: [returnId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([returnId])
  @@index([rawMaterialId])
  @@map("return_items")
}

// ============================================================
// Delegates
// ============================================================

enum DelegateStatus {
  AVAILABLE
  UNAVAILABLE
}

model Delegate {
  id       Int            @id @default(autoincrement())
  name     String
  whatsapp String
  phone    String
  image    String?
  status   DelegateStatus @default(AVAILABLE)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
  @@map("delegates")
}

// ============================================================
// Cash Drawer Shifts
// ============================================================

enum ShiftStatus {
  OPEN
  CLOSED
}

enum DrawerTransactionType {
  SALES
  COLLECTION
  EXPENSE
  SALARY
  MAINTENANCE
  PURCHASE
  INCENTIVE
}

model CashDrawerShift {
  id             Int         @id @default(autoincrement())
  openedByUserId Int
  openedAt       DateTime    @default(now())
  openingBalance Decimal
  closedByUserId Int?
  closedAt       DateTime?
  closingBalance Decimal?
  actualBalance  Decimal?
  difference     Decimal?
  notes          String?
  status         ShiftStatus @default(OPEN)

  openedByUser User  @relation("OpenedShifts", fields: [openedByUserId], references: [id], onDelete: Restrict)
  closedByUser User? @relation("ClosedShifts", fields: [closedByUserId], references: [id], onDelete: SetNull)

  transactions CashDrawerTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([openedByUserId])
  @@index([status])
  @@index([openedAt])
  @@map("cash_drawer_shifts")
}

model CashDrawerTransaction {
  id               Int                   @id @default(autoincrement())
  shiftId          Int
  type             DrawerTransactionType
  amount           Decimal
  description      String?
  recordedByUserId Int

  shift          CashDrawerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  recordedByUser User            @relation("RecordedDrawerTransactions", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([shiftId])
  @@index([type])
  @@map("cash_drawer_transactions")
}

// ============================================================
// Audit Log
// ============================================================

model AuditLog {
  id          Int     @id @default(autoincrement())
  userId      Int?
  page        String
  action      String
  description String?
  ipAddress   String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([page])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Reviews
// ============================================================

model Review {
  id            Int     @id @default(autoincrement())
  customerName  String
  customerPhone String
  rating        Int
  comment       String?

  createdAt DateTime @default(now())

  @@index([rating])
  @@index([createdAt])
  @@map("reviews")
}

// ============================================================
// Settings
// ============================================================

model Setting {
  id              Int     @id @default(autoincrement())
  key             String  @unique
  value           String?
  description     String?
  updatedByUserId Int?

  updatedByUser User? @relation("UpdatedSettings", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model ProductCategory {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_categories")
}

model Attendance {
  id          Int       @id @default(autoincrement())
  userId      Int
  checkInAt   DateTime
  checkOutAt  DateTime?
  status      String    @default("ON_TIME")
  lateMinutes Int       @default(0)
  notes       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([checkInAt])
  @@map("attendance")
}

model EmployeeDevice {
  id                Int    @id @default(autoincrement())
  userId            Int
  name              String
  deviceFingerprint String @unique
  deviceInfo        Json?
  status            String @default("PENDING")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([deviceFingerprint])
  @@index([status])
  @@map("employee_devices")
}

model OrderEvent {
  id      Int     @id @default(autoincrement())
  orderId Int
  type    String
  status  String?
  notes   String?
  userId  Int?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@map("order_events")
}
